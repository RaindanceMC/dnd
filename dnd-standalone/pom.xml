<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>dnd-build</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>dnd-standalone</artifactId>
    <!-- Published at the plugin's own version. -->
    <version>${plugin.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Adventurers</name>
    <description>
        Rain's Adventurers, as a plugin of its own: the dnd module and the standard wrapper, shaded together.
    </description>

    <properties>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>RainsAdventurers</plugin.name>

        <!-- 0.1.0: the first release — six classes (fighter, barbarian, rogue, wizard, sorcerer, cleric),
             levels 1 to 20, spell slots, sorcery points and metamagic, the casting stance, short and long rests. -->
        <!-- 0.2.0: subclasses (Champion, Berserker, Thief, Evocation, Life, and the sorcerer's choice of Wild Magic
             with its own d100 surge table or Draconic Bloodline); magic items — potions, spell scrolls, +1 to +3
             weapons, a wand, ring, amulet, boots, a bag — dropped by monsters by rarity. -->
        <!-- 0.2.1: /adventurer stance and /adventurer rest close an open menu first. -->
        <!-- 0.3.0: its own looks — a 32px icon for every spell, feature, class, subclass and metamagic; 3D models
             for every magic item, made in Blockbench; rune overlays for +1 to +3 swords and axes. -->
        <!-- 0.8.0: the Potion of Mach Fuck — brewed from a dragon head and any plain potion, a rocket flask of its own; drunk and gliding, wherever you look at mach.blocks-per-second (600) for mach.seconds (20), crashes and falls forgiven until five seconds after; never loot. An advancement tab: Rain's Adventurers, Hold My Elytra, Mach Fuck, Low Earth Orbit. -->
        <!-- 0.9.0: more Potion of Mach Fuck advancements — Lithobraking, Wasted Potential, Double Shot, Triple Batch, Hellfire Express. -->
        <!-- 0.10.0: the Potion of Mach Fuck keeps you flying while it works — a folded elytra opens again, somebody standing is lifted off first. -->
        <plugin.version>0.10.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>dnd-module</artifactId>
            <version>${dnd-module.version}</version>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
